### 4. 型安全性

```ts
// 悪い例: any の使用
function processDataBad(data: any): any {
  return data.map((item: any) => item.value);
}

// 良い例: 具体的な型定義
interface DataItem {
  id: string;
  value: number;
  metadata?: Record<string, unknown>;
}

function processDataGood(data: DataItem[]): number[] {
  return data.map(item => item.value);
}

// より実践的な例: APIレスポンスの型定義
interface ApiResponse<T> {
  data: T;
  meta: {
    page: number;
    total: number;
    lastUpdated: string;
  };
  error?: {
    code: string;
    message: string;
  };
}

async function fetchUsers(): Promise<ApiResponse<User[]>> {
  const response = await fetch('/api/users');
  if (!response.ok) {
    throw new Error('Failed to fetch users');
  }
  return response.json();
}
```

### 5. 変数宣言

```ts
// 悪い例: let の使用
let count = 0;
count = count + 1;

// 良い例: const の使用
const initialCount = 0;
const updatedCount = initialCount + 1;

// より実践的な例: フォーム状態の管理
interface FormState {
  values: Record<string, string>;
  errors: Record<string, string>;
  isDirty: boolean;
}

function useFormState(initialValues: Record<string, string>) {
  const [state, setState] = useState<FormState>({
    values: initialValues,
    errors: {},
    isDirty: false
  });

  const updateField = (field: string, value: string) => {
    setState(prev => ({
      ...prev,
      values: { ...prev.values, [field]: value },
      isDirty: true
    }));
  };

  return { state, updateField };
}
```

### 6. 定数化

```ts
// 悪い例: マジックナンバー
if (user.age < 18) {
  return "未成年";
}

// 良い例: 定数の使用
const LEGAL_AGE = 18;
const MAX_RETRY_COUNT = 3;
const API_TIMEOUT = 5000;

if (user.age < LEGAL_AGE) {
  return "未成年";
}

// より実践的な例: 設定値の定数化
const AUTH_CONFIG = {
  TOKEN_EXPIRY: 24 * 60 * 60 * 1000, // 24時間
  MIN_PASSWORD_LENGTH: 8,
  MAX_LOGIN_ATTEMPTS: 5,
  LOCKOUT_DURATION: 30 * 60 * 1000, // 30分
} as const;

const API_CONFIG = {
  BASE_URL: 'https://api.example.com',
  VERSION: 'v1',
  TIMEOUT: 10000,
  RETRY_COUNT: 3,
} as const;

const FILE_UPLOAD_CONFIG = {
  MAX_SIZE: 5 * 1024 * 1024, // 5MB
  ALLOWED_TYPES: ['image/jpeg', 'image/png', 'application/pdf'],
  MAX_FILES: 10,
} as const;
```