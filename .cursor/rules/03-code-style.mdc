# コードスタイル

- 文字列結合は **テンプレートリテラル** を使用。  
- 単純な条件分岐は **三項演算子** または **オブジェクトマッピング** を使用。  
- import 順序: 外部 → UI → alias → 相対。  
- `any` 型とデフォルトエクスポートは禁止。  
- 変数は `const`、再代入が必要なら別名変数。  
- マジックナンバーは定数化。  

## コード例

### 1. 文字列結合

```ts
// 悪い例: + 演算子による結合
const fullNameBad = firstName + " " + lastName;
const messageBad = "Hello, " + name + "! You have " + count + " messages.";

// 良い例: テンプレートリテラル
const fullNameGood = `${firstName} ${lastName}`;
const messageGood = `Hello, ${name}! You have ${count} messages.`;

// より実践的な例: APIエンドポイントの構築
const API_BASE = 'https://api.example.com';
const VERSION = 'v1';

function buildApiEndpoint(path: string, queryParams?: Record<string, string>): string {
  const endpoint = `${API_BASE}/${VERSION}/${path}`;
  if (!queryParams) return endpoint;

  const queryString = Object.entries(queryParams)
    .map(([key, value]) => `${encodeURIComponent(key)}=${encodeURIComponent(value)}`)
    .join('&');

  return `${endpoint}?${queryString}`;
}

// 使用例
const userEndpoint = buildApiEndpoint('users', { id: '123', fields: 'name,email' });
// 結果: 'https://api.example.com/v1/users?id=123&fields=name%2Cemail'
```

### 2. 条件分岐

```ts
// 悪い例: if-else の連鎖
function getStatusBad(status: string): string {
  if (status === "pending") {
    return "処理中";
  } else if (status === "completed") {
    return "完了";
  } else if (status === "failed") {
    return "失敗";
  } else {
    return "不明";
  }
}

// 良い例: オブジェクトマッピング
const STATUS_MESSAGES = {
  pending: "処理中",
  completed: "完了",
  failed: "失敗",
} as const;

function getStatusGood(status: keyof typeof STATUS_MESSAGES): string {
  return STATUS_MESSAGES[status] ?? "不明";
}

// より実践的な例: ユーザーアクセスレベルの表示
type AccessLevel = 'admin' | 'editor' | 'viewer';

const ACCESS_LEVEL_CONFIG = {
  admin: {
    label: '管理者',
    color: 'red',
    permissions: ['read', 'write', 'delete']
  },
  editor: {
    label: '編集者',
    color: 'blue',
    permissions: ['read', 'write']
  },
  viewer: {
    label: '閲覧者',
    color: 'green',
    permissions: ['read']
  }
} as const;

function AccessLevelBadge({ level }: { level: AccessLevel }) {
  const config = ACCESS_LEVEL_CONFIG[level];
  return (
    <span className={`badge badge-${config.color}`}>
      {config.label}
    </span>
  );
}
```

